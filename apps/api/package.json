{
  "name": "@edukedo/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "./src/trpc/router.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-instrument-lernpfad": "tsx src/db/seed-instrument-lernpfad.ts",
    "db:import-content": "tsx src/db/import-content.ts",
    "db:export-content": "tsx src/db/export-content.ts",
    "content:scaffold": "tsx src/db/scaffold-content.ts",
    "db:send-consent-reminders": "tsx src/db/send-consent-reminders.ts",
    "db:send-learning-reminders": "tsx src/db/send-learning-reminders.ts",
    "db:send-duell-reminders": "tsx src/db/send-duell-reminders.ts"
  },
  "dependencies": {
    "@edukedo/shared": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@trpc/server": "^10.45.2",
    "argon2": "^0.40.3",
    "bullmq": "^6.3.8",
    "drizzle-orm": "^0.36.4",
    "fastify": "^4.28.1",
    "ioredis": "^6.0.0",
    "pg": "^8.12.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.1",
    "@types/pg": "^8.11.6",
    "@types/web-push": "^3.6.4"
  }
}
