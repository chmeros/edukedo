    "bullmq": "^6.3.8",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "ts-fsrs": "^4.6.2",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
