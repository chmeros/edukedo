# Kern-Backend
# Passend zu docker-compose.yml (lokale Entwicklung, siehe Architekturplanung Abschnitt 9)
DATABASE_URL=postgres://edukedo:edukedo@localhost:5432/edukedo_kern
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
PORT=3001
# Basis-URL des Frontends fuer Bestaetigungslinks in Consent-E-Mails (F-08)
WEB_BASE_URL=http://localhost:5173

# Postgres-Extensions, die die erste Migration aktivieren muss (siehe Architekturplanung Abschnitt 9):
# citext (fuer "user".email / parent.email), ggf. pgcrypto (fuer gen_random_uuid())

# Redis / BullMQ (ab Iteration 6, gemeinsam von Kern UND Payment-Service genutzt fuer die
# Event-Queue, siehe apps/payment/README.md)
REDIS_URL=redis://localhost:6379

# Payment-REST-API (F-81/F-82, Baustein 2) - PAYMENT_SERVICE_TOKEN muss exakt dem
# KERN_SERVICE_TOKEN in apps/payment/.env entsprechen, sonst lehnt Payment jeden Aufruf mit 401 ab
PAYMENT_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_TOKEN=change-me-to-a-random-string-of-at-least-16-chars

# Payment-Service selbst hat eine EIGENE .env in apps/payment (siehe apps/payment/README.md), u.a.:
# PAYMENT_DATABASE_URL=postgres://edukedo:edukedo@localhost:5433/edukedo_payment
# KERN_SERVICE_TOKEN=<derselbe Wert wie PAYMENT_SERVICE_TOKEN oben>

